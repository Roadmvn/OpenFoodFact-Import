# Configuration SonarQube
SONAR_HOST_URL=http://sonarqube-url:9000
SONAR_LOGIN=votre_login
SONAR_PASSWORD=votre_password
SONAR_PROJECT_KEY=votre_project_key
SONAR_PROJECT_NAME=votre_project_name
SONAR_PROJECT_VERSION=1.0

# Configuration Docker
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Variables pour Docker Compose
DB_HOST=db
DB_PORT=3306
DB_DEV_USERNAME=utilisateur_db
DB_DEV_PASSWORD=mot_de_passe_db
DB_DEV_DATABASE=nom_base_de_donnees
DB_DIALECT=mysql
LOG_LEVEL=info

# JWT et session (pour Docker)
JWT_SECRET=votre_secret_jwt
SESSION_SECRET=votre_secret_session

# API externes (pour Docker)
GOOGLE_CLIENT_ID=votre_client_id_google
GOOGLE_CLIENT_SECRET=votre_client_secret_google
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal
