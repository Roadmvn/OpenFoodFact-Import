# Configuration de la base de données de test
DB_USERNAME=utilisateur_test
DB_PASSWORD=mot_de_passe_test
DB_DATABASE=trinity_test
DB_HOST=127.0.0.1
DB_DIALECT=mysql

# Configuration du serveur
PORT=3000
NODE_ENV=test

# Configuration JWT et session
JWT_SECRET=secret_jwt_pour_tests
JWT_SECRET_KEY=test_secret_key_for_testing
JWT_EXPIRES_IN=1h
SESSION_SECRET=secret_session_pour_tests

# Configuration Google OAuth
GOOGLE_CLIENT_ID=id_client_google_pour_tests
GOOGLE_CLIENT_SECRET=secret_google_pour_tests

# Configuration PayPal
PAYPAL_CLIENT_ID=id_client_paypal_pour_tests
PAYPAL_CLIENT_SECRET=secret_paypal_pour_tests

# Autres configurations nécessaires pour les tests
LOG_LEVEL=error

# Configuration de l'API OpenFoodFacts (pour les tests)
OPENFOODFACTS_PAGE_SIZE=5
OPENFOODFACTS_DELAY=1000
OPENFOODFACTS_MAX_RETRIES=2