# Configuration de la base de données
DB_USERNAME=utilisateur_db
DB_PASSWORD=mot_de_passe_db
DB_DATABASE=nom_base_de_donnees
DB_HOST=127.0.0.1
DB_DIALECT=mysql

# Configuration de la base de données de développement
DB_DEV_USERNAME=utilisateur_dev
DB_DEV_PASSWORD=mot_de_passe_dev
DB_DEV_DATABASE=db_dev
DB_DEV_HOST=127.0.0.1
DB_DEV_DIALECT=mysql

# Configuration de la base de données de production
DB_PROD_USERNAME=utilisateur_prod
DB_PROD_PASSWORD=mot_de_passe_prod
DB_PROD_DATABASE=db_prod
DB_PROD_HOST=127.0.0.1
DB_PROD_DIALECT=mysql

# Configuration du serveur
PORT=3000
NODE_ENV=development

# Configuration JWT et session
JWT_SECRET=votre_secret_jwt
JWT_EXPIRES_IN=1h
SESSION_SECRET=votre_secret_session

# Configuration de l'API OpenFoodFacts
OPENFOODFACTS_PAGE_SIZE=25
OPENFOODFACTS_DELAY=5000
OPENFOODFACTS_MAX_RETRIES=5

# Configuration Google OAuth
GOOGLE_CLIENT_ID=votre_client_id_google
GOOGLE_CLIENT_SECRET=votre_client_secret_google

# Configuration PayPal
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal

# Configuration des logs
LOG_LEVEL=info